function tr(){return I18N[state.lang]||I18N.ru}
function setHtml(id,value){const e=$('#'+id);if(e)e.innerHTML=value}
function setText(id,value){const e=$('#'+id);if(e)e.textContent=value}
function applyLanguage(){
 const t=tr();document.documentElement.lang=state.lang;
 setText('heroEyebrow',t.heroEyebrow);setHtml('heroTitle',t.heroTitle);setText('heroText',t.heroText);
 setText('hoursEyebrow',t.hoursEyebrow);setText('hoursTitle',t.hoursTitle);setText('hoursText',t.hoursText);
 setText('nextEyebrow',t.next);setText('wheelEyebrow',t.wheel);
 setText('moonEyebrow',t.moonEyebrow);setText('moonTitle',t.moonTitle);setText('moonText',t.moonText);
 setText('plannerEyebrow',t.plannerEyebrow);setText('plannerTitle',t.plannerTitle);setText('plannerText',t.plannerText);
 setText('langEyebrow',t.langEyebrow);setText('langTitle',t.langTitle);
 setText('installEyebrow',t.installEyebrow);setText('installTitle',t.installTitle);setText('installLead',t.installLead);
 if($('#quickPlan'))$('#quickPlan').textContent=t.plan;if($('#addPlan'))$('#addPlan').textContent=t.add;
 const cta=$('.install-cta');if(cta){cta.querySelector('b').textContent=t.install;cta.querySelector('small').textContent=t.installSub}
 const labels=$$('.now-info .eyebrow,.explain b');if(labels[0])labels[0].textContent=t.now;if(labels[1])labels[1].textContent=t.suitable;if(labels[2])labels[2].textContent=t.avoid;
 if($('#planCurrent'))$('#planCurrent').textContent=t.planHour;if($('#planNext'))$('#planNext').textContent=t.planNext;
 renderLang();renderIntent();renderMoon();renderLunarMonth();renderAll();renderPractices();updateClock();
}


function lunarEventDate(cycleIndex,fraction){
  return new Date(REF+(cycleIndex+fraction)*SYN*864e5)
}
function nextLunarEvent(fraction,now=new Date()){
  const cycles=(now-REF)/(SYN*864e5);
  let idx=Math.floor(cycles-fraction)+1;
  let date=lunarEventDate(idx,fraction);
  if(date<=now){idx++;date=lunarEventDate(idx,fraction)}
  return date
}
function prevLunarEvent(fraction,now=new Date()){
  const cycles=(now-REF)/(SYN*864e5);
  let idx=Math.floor(cycles-fraction);
  let date=lunarEventDate(idx,fraction);
  if(date>now){idx--;date=lunarEventDate(idx,fraction)}
  return date
}
function durationText(ms){
  ms=Math.max(0,ms);
  const days=Math.floor(ms/864e5),hours=Math.floor(ms/36e5)%24,mins=Math.floor(ms/6e4)%60;
  return `${days} дн. ${hours} ч. ${mins} мин.`
}
function shortLunarDate(d){
  return new Intl.DateTimeFormat(tr().locale,{timeZone:state.tz,day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}).format(d)
}
function renderLunarMonth(){
  const now=new Date(),m=moonInfo(now),phase=m.phase,age=phase*SYN;
  const cycleIndex=Math.floor((now-REF)/(SYN*864e5));
  const currentNew=lunarEventDate(cycleIndex,0);
  const nextNew=lunarEventDate(cycleIndex+1,0);
  const first=lunarEventDate(cycleIndex,.25);
  const full=lunarEventDate(cycleIndex,.5);
  const last=lunarEventDate(cycleIndex,.75);

  const points=[
    {f:0,name:'Новолуние',date:currentNew},
    {f:.25,name:'Первая четверть',date:first},
    {f:.5,name:'Полнолуние',date:full},
    {f:.75,name:'Последняя четверть',date:last},
    {f:1,name:'Новолуние',date:nextNew}
  ];
  const nextPoint=points.find(x=>x.date>now)||points[4];
  const currentName=phases[m.idx].name;
  const nextName=nextPoint.name;
  const direction=phase<.5?'Луна растёт':'Луна убывает';

  $('#lunarCurrentPhase').textContent=currentName;
  $('#lunarTransitionText').textContent=`Сейчас ${currentName.toLowerCase()}; следующий переход — ${nextName.toLowerCase()} ${shortLunarDate(nextPoint.date)}.`;
  $('#lunarNextLabel').textContent=`До: ${nextName}`;
  $('#lunarNextCountdown').textContent=durationText(nextPoint.date-now);

  const progress=Math.max(0,Math.min(1,phase));
  const track=$('.lunar-cycle-track');
  if(innerWidth<=760){
    $('#lunarCycleProgress').style.height=(progress*276)+'px';
    $('#lunarCycleProgress').style.width='3px';
    $('#lunarCycleMarker').style.top=(12+progress*276)+'px';
  }else{
    $('#lunarCycleProgress').style.width=(progress*92)+'%';
    $('#lunarCycleProgress').style.height='3px';
    $('#lunarCycleMarker').style.left=(4+progress*92)+'%';
  }

  $('#newMoonDate').textContent=shortLunarDate(currentNew);
  $('#firstQuarterDate').textContent=shortLunarDate(first);
  $('#fullMoonDateExact').textContent=shortLunarDate(full);
  $('#lastQuarterDate').textContent=shortLunarDate(last);

  const upcomingNew=nextLunarEvent(0,now),upcomingFull=nextLunarEvent(.5,now);
  $('#nextNewMoon').textContent=shortLunarDate(upcomingNew);
  $('#toNewMoon').textContent='через '+durationText(upcomingNew-now);
  $('#nextFullMoon').textContent=shortLunarDate(upcomingFull);
  $('#toFullMoon').textContent='через '+durationText(upcomingFull-now);
  $('#moonAge').textContent=age.toFixed(1)+' суток';
  $('#moonCycleDay').textContent=`примерно ${Math.floor(age)+1}-й лунный день`;
  $('#moonDirection').textContent=direction;
  $('#moonDirectionNote').textContent=phase<.5?'сила прибавляется':'сила идёт на убыль';

  const meanings=[
    'Период сокрытия и тишины. Подходит для очищения места, подготовки орудий, обетов и закладывания намерения.',
    'Сила прибавляется. Подходит для укрепления, привлечения, роста дела, защиты, достатка и открытия дорог.',
    'Период полноты и явленности. Подходит для освящения, прорицания, кульминации практики и работы со снами.',
    'Сила убывает. Подходит для отсечения, изгнания, очищения, закрытия, отпускания и завершения.'
  ];
  $('#lunarMeaningText').textContent=meanings[m.idx];
}


