const zodiacSigns=['Овен','Телец','Близнецы','Рак','Лев','Дева','Весы','Скорпион','Стрелец','Козерог','Водолей','Рыбы'];
let astroPositions=[],selectedAstroPlanet=0;
function fallbackLongitude(i,date=new Date()){const periods=[10759,4332.6,687,365.256,224.7,88,27.32],base=[300,20,120,280,340,220,90];return((base[i]+((date-REF)/864e5)/periods[i]*360)%360+360)%360}
function calculateAstronomy(){
 const observer=window.Astronomy?new Astronomy.Observer(state.lat||52.2297,state.lon||21.0122,0):null;
 astroPositions=astroPlanets.map((p,i)=>{let lon=fallbackLongitude(i),alt=0,az=0;try{if(observer){lon=((Astronomy.EclipticLongitude(p.body,new Date())%360)+360)%360;const eq=Astronomy.Equator(p.body,new Date(),observer,true,true),h=Astronomy.Horizon(new Date(),observer,eq.ra,eq.dec,'normal');alt=h.altitude;az=h.azimuth}}catch{}return{lon,alt,az}});
 const moon=astroPositions[6];if($('#moonAltitude'))$('#moonAltitude').textContent=moon.alt.toFixed(1)+'°';if($('#moonAzimuth'))$('#moonAzimuth').textContent=moon.az.toFixed(1)+'°';
 renderPlanetarium();selectAstroPlanet(selectedAstroPlanet);$('#status').textContent=observer?'Astronomy Engine активен':'Работают резервные расчёты'
}
function renderPlanetarium(){const box=$('#planetarium');if(!box)return;box.querySelectorAll('.planet-node').forEach(n=>n.remove());const pos=[[50,13],[77,28],[86,56],[66,79],[35,83],[14,58],[24,29]];astroPlanets.forEach((p,i)=>{const b=document.createElement('button');b.className='planet-node'+(i===selectedAstroPlanet?' active':'');b.dataset.astroPlanet=i;b.style.left=pos[i][0]+'%';b.style.top=pos[i][1]+'%';b.innerHTML=`<b>${p.seal}</b><small>${p.name.toUpperCase()}</small>`;box.appendChild(b)});drawAspects()}
function drawAspects(){const c=$('#aspectCanvas'),box=$('#planetarium');if(!c||!box)return;const r=box.getBoundingClientRect(),d=devicePixelRatio||1;c.width=r.width*d;c.height=r.height*d;const x=c.getContext('2d');x.scale(d,d);const nodes=[...box.querySelectorAll('.planet-node')];for(let i=0;i<astroPositions.length;i++)for(let j=i+1;j<astroPositions.length;j++){let q=Math.abs(astroPositions[i].lon-astroPositions[j].lon);q=Math.min(q,360-q);const aspect=[0,60,90,120,180].find(a=>Math.abs(q-a)<6);if(aspect===undefined)continue;const A=nodes[i],B=nodes[j];x.strokeStyle=aspect===90?'rgba(201,138,150,.45)':aspect===60||aspect===120?'rgba(143,200,162,.45)':'rgba(223,188,112,.42)';x.beginPath();x.moveTo(A.offsetLeft,A.offsetTop);x.lineTo(B.offsetLeft,B.offsetTop);x.stroke()}}
function selectAstroPlanet(i){selectedAstroPlanet=+i;$$('.planet-node').forEach((n,j)=>n.classList.toggle('active',j===selectedAstroPlanet));const p=astroPlanets[selectedAstroPlanet],a=astroPositions[selectedAstroPlanet]||{lon:0,alt:0,az:0};$('#planetDetailName').textContent=p.name;$('#planetDetailTags').innerHTML=p.tags.map(x=>`<span>${x}</span>`).join('');$('#planetSign').textContent=zodiacSigns[Math.floor(a.lon/30)%12];$('#planetLongitude').textContent=a.lon.toFixed(2)+'°';$('#planetAltitude').textContent=a.alt.toFixed(2)+'°';$('#planetAzimuth').textContent=a.az.toFixed(2)+'°';$('#planetMetal').textContent=p.metal;$('#planetSphere').textContent=p.sphere;$('#planetHistory').textContent=p.history}

function initSky(){const c=$('#stars'),x=c.getContext('2d');let stars=[];function resize(){c.width=innerWidth*devicePixelRatio;c.height=innerHeight*devicePixelRatio;x.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);stars=Array.from({length:Math.min(260,innerWidth/3)},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*1.1+.15,a:Math.random(),v:Math.random()*.008+.002}))}function draw(){x.clearRect(0,0,innerWidth,innerHeight);for(const s of stars){s.a+=s.v;if(s.a>1||s.a<.1)s.v*=-1;x.globalAlpha=s.a;x.fillStyle='#fff8e9';x.beginPath();x.arc(s.x,s.y,s.r,0,Math.PI*2);x.fill()}x.globalAlpha=1;requestAnimationFrame(draw)}addEventListener('resize',()=>{resize();renderLunarMonth();drawAspects()});resize();draw()}
function init(){history.scrollRestoration='manual';window.scrollTo(0,0);initSky();calculateAstronomy();fallbackHours();renderMoon();renderLunarMonth();renderPractices();renderLang();applyLanguage();updateClock();setInterval(updateClock,1000);setInterval(()=>{renderMoon();renderLunarMonth()},60000);locate();$('#planetarium').onclick=e=>{const b=e.target.closest('[data-astro-planet]');if(b)selectAstroPlanet(b.dataset.astroPlanet)};$('#intentDock').onclick=e=>{const b=e.target.closest('[data-intent]');if(!b)return;state.intent=b.dataset.intent;renderAll()};$('#dayWheel').onclick=e=>{const b=e.target.closest('[data-hour]');if(!b)return;const h=state.hours[+b.dataset.hour],p=planetData[h.p];openPlan({title:'Практика в час '+p.n,date:new Date(h.start).toISOString().slice(0,10),time:new Date(h.start).toTimeString().slice(0,5),note:'Силы: '+p.powers.join(', ')+'. Подходит: '+p.works})};$('#lunarMonth').onclick=e=>{const b=e.target.closest('[data-point]');if(!b)return;const labels={new:'Новолуние',first:'Первая четверть',full:'Полнолуние',last:'Последняя четверть'};openPlan({title:'Практика — '+labels[b.dataset.point]})};$('#phaseRail').onclick=e=>{const b=e.target.closest('[data-phase]');if(!b)return;const p=phases[+b.dataset.phase];openPlan({title:'Практика — '+p.name,note:p.desc+' '+p.works.join(', ')})};$('#quickPlan').onclick=$('#addPlan').onclick=()=>openPlan();$('#planCurrent').onclick=()=>{const h=currentHour(),p=planetData[h.p];openPlan({title:'Практика в час '+p.n,date:new Date(h.start).toISOString().slice(0,10),time:new Date(h.start).toTimeString().slice(0,5),note:p.works})};$('#planNext').onclick=()=>{const h=state.hours[state.nextIndex],p=planetData[h.p];openPlan({title:'Практика в час '+p.n,date:new Date(h.start).toISOString().slice(0,10),time:new Date(h.start).toTimeString().slice(0,5),note:p.works})};$$('[data-close-plan]').forEach(x=>x.onclick=closePlan);$('#planForm').onsubmit=async e=>{e.preventDefault();let rem=$('#pReminder').checked;if(rem&&'Notification'in window&&Notification.permission==='default')rem=(await Notification.requestPermission())==='granted';const list=practices();list.push({id:Date.now(),title:$('#pTitle').value.trim(),date:$('#pDate').value,time:$('#pTime').value,type:$('#pType').value,note:$('#pNote').value.trim(),reminder:rem});localStorage.setItem('lunarisV14Practices',JSON.stringify(list));renderPractices();closePlan();toast(tr().saved)};$('#practiceList').onclick=e=>{const b=e.target.closest('[data-del]');if(!b)return;localStorage.setItem('lunarisV14Practices',JSON.stringify(practices().filter(x=>x.id!=b.dataset.del)));renderPractices()};$$('[data-go]').forEach(b=>b.onclick=()=>document.getElementById(b.dataset.go).scrollIntoView({behavior:'smooth'}));$('#langBtn').onclick=()=>{$('#langModal').classList.add('open');renderLang()};
const mobileLang=$('#mobileLangBtn'); if(mobileLang) mobileLang.onclick=()=>{$('#langModal').classList.add('open');renderLang()};
const mobileInstall=$('#mobileInstallBtn'); if(mobileInstall) mobileInstall.onclick=openInstall;
$$('[data-close-lang]').forEach(x=>x.onclick=()=>$('#langModal').classList.remove('open'));$('#langGrid').onclick=e=>{const b=e.target.closest('[data-lang]');if(!b)return;state.lang=b.dataset.lang;localStorage.setItem('lunarisLang',state.lang);applyLanguage();$('#langModal').classList.remove('open');requestAnimationFrame(()=>window.scrollTo({top:0,left:0,behavior:'smooth'}))};$('#installBtn').onclick=openInstall;$$('[data-install]').forEach(x=>x.onclick=openInstall);$$('[data-close-install]').forEach(x=>x.onclick=()=>$('#installModal').classList.remove('open'));$('#nativeInstall').onclick=async()=>{if(state.installPrompt){state.installPrompt.prompt();await state.installPrompt.userChoice;state.installPrompt=null;$('#installModal').classList.remove('open')}};addEventListener('beforeinstallprompt',e=>{e.preventDefault();state.installPrompt=e});addEventListener('appinstalled',()=>{state.installPrompt=null;toast('LUNARIS установлен');$('#installModal').classList.remove('open')});$('#pType').innerHTML=['Очищение','Защита','Достаток','Согласие','Познание','Отсечение','Почитание','Другое'].map(x=>`<option>${x}</option>`).join('');if('serviceWorker'in navigator&&location.protocol.startsWith('http'))navigator.serviceWorker.register('./sw.js').catch(()=>{})}
window.addEventListener('pageshow',()=>setTimeout(()=>window.scrollTo(0,0),0));document.readyState==='loading'?document.addEventListener('DOMContentLoaded',init):init();
</script>
</body></html>