<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#07070b">
<meta name="description" content="LUNARIS — живой ритуальный навигатор Ордена VERBUM DAEMONIS">
<link rel="manifest" href="manifest.webmanifest">
<title>LUNARIS · VERBUM DAEMONIS</title>
<style>
:root{--bg:#07070b;--panel:#111019cc;--panel2:#17131ddd;--line:#ffffff16;--gold:#dfbd70;--gold2:#f7e2ac;--ink:#f4eee4;--muted:#9f98a7;--good:#8bc9a0;--danger:#c78a96;--violet:#785d9b}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#07070b;color:var(--ink);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;overflow-x:hidden}
button,input,select,textarea{font:inherit}button{cursor:pointer}.bg{position:fixed;inset:0;z-index:-5;background:radial-gradient(circle at 72% 8%,#2c203f 0,transparent 34%),radial-gradient(circle at 10% 82%,#3b1725 0,transparent 32%),#07070b}
#stars{position:fixed;inset:0;z-index:-4}.veil{position:fixed;inset:-20%;z-index:-3;background:conic-gradient(from 0deg at 50% 50%,transparent,#6a4d8930,transparent,#8a4e5f20,transparent);filter:blur(70px);animation:veil 36s linear infinite}@keyframes veil{to{transform:rotate(360deg) scale(1.1)}}
.shell{display:grid;grid-template-columns:92px minmax(0,1fr);min-height:100vh}.rail{position:sticky;top:0;height:100vh;border-right:1px solid var(--line);background:#09080ecc;backdrop-filter:blur(22px);display:flex;flex-direction:column;align-items:center;padding:18px 10px;z-index:30}.logo{width:56px;height:56px;border:1px solid #9b7948;border-radius:50%;display:grid;place-items:center;color:var(--gold2);font-size:28px;box-shadow:inset 0 0 25px #d9b86d16,0 0 30px #000}.rail nav{display:grid;gap:10px;margin-top:38px}.navbtn{width:54px;height:54px;border:1px solid transparent;border-radius:16px;background:transparent;color:#8e8794;font-size:20px}.navbtn.active,.navbtn:hover{background:#ffffff09;border-color:var(--line);color:var(--gold2)}.rail-bottom{margin-top:auto;display:grid;gap:8px}.mini{width:54px;height:44px;border:1px solid var(--line);border-radius:13px;background:#ffffff08;color:#ddd}
main{width:100%;max-width:1600px;margin:auto;padding:24px clamp(18px,4vw,68px) 80px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:14px}.brand h1{font-family:Georgia,serif;font-size:20px;letter-spacing:.22em;margin:0}.brand small{font-size:8px;letter-spacing:.22em;color:#8f8794}.status{display:flex;align-items:center;gap:9px;color:#aaa3af;font-size:10px;padding:9px 12px;border:1px solid var(--line);border-radius:999px;background:#ffffff07}.dot{width:7px;height:7px;border-radius:50%;background:var(--good);box-shadow:0 0 14px var(--good);animation:pulse 2s infinite}@keyframes pulse{50%{opacity:.45;transform:scale(.75)}}
.hero{min-height:760px;display:grid;grid-template-columns:minmax(320px,.88fr) minmax(520px,1.25fr);align-items:center;gap:5vw;padding:34px 0}.hero-copy .eyebrow{font-size:10px;letter-spacing:.25em;color:var(--gold);font-weight:900}.clock{font-family:Georgia,serif;font-size:clamp(84px,10vw,154px);line-height:.9;letter-spacing:-.07em;font-variant-numeric:tabular-nums;white-space:nowrap}.date{color:var(--gold2);font-size:11px;letter-spacing:.14em;text-transform:uppercase;margin-top:12px}.hero-copy h2{font-family:Georgia,serif;font-size:clamp(36px,4vw,68px);line-height:1.02;margin:35px 0 15px}.hero-copy h2 em{color:var(--gold2);font-style:normal}.hero-copy p{max-width:620px;color:#b4acb9;line-height:1.8}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.primary,.ghost{border-radius:14px;padding:14px 18px;font-weight:800}.primary{border:0;background:linear-gradient(135deg,#f0cf82,#b88a3c);color:#171008;box-shadow:0 15px 40px #d5aa5530}.ghost{border:1px solid var(--line);background:#ffffff08;color:var(--ink)}
.sphere-wrap{position:relative;min-height:650px;display:grid;place-items:center}.sphere{width:min(620px,78vw);aspect-ratio:1;border-radius:50%;position:relative;display:grid;place-items:center;isolation:isolate}.sphere:before{content:"";position:absolute;inset:7%;border:1px solid #d7b56a33;border-radius:50%;box-shadow:0 0 120px #745d9830,inset 0 0 70px #000}.ring{position:absolute;border:1px solid #d9b86d28;border-radius:50%;animation:spin linear infinite}.r1{inset:2%;animation-duration:45s}.r2{inset:15% 1%;transform:rotate(25deg);animation-duration:34s;animation-direction:reverse}.r3{inset:4% 21%;transform:rotate(-24deg);animation-duration:29s}.r4{inset:27% 0;animation-duration:55s}@keyframes spin{to{transform:rotate(360deg)}}.ticks{position:absolute;inset:0;border-radius:50%;background:repeating-conic-gradient(from -90deg,#dcbf7d55 0 1deg,transparent 1deg 15deg);mask:radial-gradient(transparent 0 48%,#000 49% 51%,transparent 52%)}.moon{width:48%;aspect-ratio:1;border-radius:50%;position:relative;overflow:hidden;background:radial-gradient(circle at 32% 28%,#fff7df,#c9bfa5 52%,#6d685d);box-shadow:0 0 50px #ffe5a344,0 0 150px #745a9238;animation:moonBreath 6s ease-in-out infinite}@keyframes moonBreath{50%{transform:scale(1.025);box-shadow:0 0 75px #ffe5a355,0 0 190px #745a9242}}.moon:after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 25% 28%,#55504455 0 6%,transparent 7%),radial-gradient(circle at 70% 60%,#514c4255 0 10%,transparent 11%),radial-gradient(circle at 46% 73%,#69625344 0 5%,transparent 6%);animation:texture 15s ease-in-out infinite alternate}@keyframes texture{to{transform:translate(2%,-2%) scale(1.03)}}.shadow{position:absolute;inset:-3%;border-radius:50%;background:#08080c;z-index:2;transition:transform 1s ease}.core{position:absolute;text-align:center;z-index:4;pointer-events:none}.core .phase{font-family:Georgia,serif;font-size:22px}.core .illum{font-size:10px;color:#aaa2af;margin-top:6px}.planet-orb{position:absolute;right:7%;bottom:15%;width:118px;height:118px;border:1px solid #d7b56a55;border-radius:50%;background:#0c0a11dd;display:grid;place-items:center;box-shadow:0 18px 50px #000b;animation:float 5s ease-in-out infinite}@keyframes float{50%{transform:translateY(-9px)}}.planet-orb b{font-size:48px;color:var(--gold2)}.planet-orb span{position:absolute;bottom:15px;font-size:8px;letter-spacing:.14em;color:#aaa}
.ribbon{position:absolute;left:3%;bottom:10%;width:190px;padding:15px;border:1px solid var(--line);border-radius:17px;background:#0e0c13d9;backdrop-filter:blur(16px)}.ribbon small{font-size:8px;letter-spacing:.15em;color:var(--gold)}.ribbon strong{display:block;font-family:Georgia,serif;font-size:20px;margin:8px 0}.ribbon span{font-size:10px;color:#aaa}
.section{padding:66px 0}.section-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:22px}.section-head h2{font-family:Georgia,serif;font-size:clamp(34px,4vw,58px);margin:5px 0}.section-head p{color:var(--muted);max-width:670px;line-height:1.7}.eyebrow{font-size:9px;color:var(--gold);letter-spacing:.22em;font-weight:900}
.intent-dock{display:flex;gap:9px;overflow:auto;padding:4px 0 12px;scrollbar-width:none}.intent-dock button{flex:0 0 auto;border:1px solid var(--line);background:#ffffff06;color:#bbb3bf;border-radius:999px;padding:11px 15px}.intent-dock button.active{background:linear-gradient(135deg,#e0bd70,#a97935);color:#160f08;border-color:transparent;box-shadow:0 8px 30px #d4a65228}
.navigator{display:grid;grid-template-columns:1.15fr .85fr;gap:16px}.glass{background:linear-gradient(145deg,#16131ddd,#0d0b12e6);border:1px solid var(--line);box-shadow:0 28px 70px #0008;backdrop-filter:blur(18px)}.now-panel{border-radius:26px;padding:26px;min-height:430px;display:grid;grid-template-columns:210px 1fr;gap:25px}.planet-seal{width:190px;height:190px;border-radius:50%;border:1px solid #b69051;display:grid;place-items:center;font-size:92px;color:var(--gold2);box-shadow:inset 0 0 60px #d8b56513,0 0 60px #000;position:relative}.planet-seal:after{content:"";position:absolute;inset:-13px;border:1px dashed #d7b56a33;border-radius:50%;animation:spin 25s linear infinite}.now-info h3{font-family:Georgia,serif;font-size:42px;margin:6px 0}.time-window{font-size:13px;color:var(--gold2)}.strength{display:flex;gap:7px;flex-wrap:wrap;margin:17px 0}.strength span{padding:7px 10px;border:1px solid var(--line);background:#ffffff06;border-radius:999px;font-size:10px}.explain{display:grid;grid-template-columns:1fr 1fr;gap:10px}.explain div{padding:14px;border-radius:14px;background:#ffffff05}.explain b{font-size:9px;letter-spacing:.12em}.explain p{font-size:11px;line-height:1.55;color:#b8afbc}.good b{color:var(--good)}.avoid b{color:var(--danger)}.progress{height:3px;background:#ffffff0d;border-radius:99px;margin:20px 0}.progress span{display:block;height:100%;width:50%;background:linear-gradient(90deg,#b88b3e,#f4dfa5);box-shadow:0 0 15px #d9b86d80}
.next-panel{border-radius:26px;padding:24px;display:flex;flex-direction:column}.next-panel h3{font-family:Georgia,serif;font-size:32px;margin:8px 0}.next-time{font-size:44px;font-family:Georgia,serif;color:var(--gold2)}.why{margin:17px 0;padding:15px;border-left:2px solid var(--gold);background:#d9b86d0b;color:#bcb3bf;font-size:11px;line-height:1.6}.mini-cycle{display:grid;gap:8px;margin-top:auto}.mini-hour{display:grid;grid-template-columns:48px 1fr auto;gap:10px;align-items:center;padding:10px;border-radius:12px;background:#ffffff05}.mini-hour i{font-style:normal;font-size:25px;color:var(--gold2)}.mini-hour b{display:block}.mini-hour span{font-size:9px;color:#8f8795}
.daywheel{border-radius:28px;padding:24px;overflow:hidden}.wheel-track{display:grid;grid-template-columns:repeat(24,minmax(94px,1fr));gap:8px;overflow:auto;padding:8px 2px 16px;scroll-snap-type:x mandatory}.hour-node{scroll-snap-align:center;border:1px solid var(--line);border-radius:16px;padding:13px;background:#ffffff04;min-height:152px;display:flex;flex-direction:column;transition:.25s}.hour-node.current{border-color:#d2aa61;transform:translateY(-5px);background:linear-gradient(180deg,#2c2118,#141019)}.hour-node.match{box-shadow:0 0 0 1px #86c69a45}.hour-node.dim{opacity:.25}.hour-node .sym{font-size:28px;color:var(--gold2)}.hour-node b{font-size:12px;margin-top:9px}.hour-node time{font-size:9px;color:#938a98;margin-top:5px}.hour-node small{margin-top:auto;color:#aaa;font-size:8px;line-height:1.4}
.lunar-story{display:grid;grid-template-columns:1fr 1.2fr;gap:16px}.moon-timeline{border-radius:28px;padding:25px}.phase-rail{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.phase-step{position:relative;border:1px solid var(--line);border-radius:18px;padding:16px;min-height:210px;background:#ffffff04;transition:.3s}.phase-step.active{border-color:#c99f58;background:linear-gradient(145deg,#2b2118,#111019);transform:translateY(-6px)}.phase-step i{font-style:normal;font-size:38px;color:var(--gold2)}.phase-step h4{font-family:Georgia,serif;font-size:20px;margin:12px 0 7px}.phase-step p{font-size:10px;line-height:1.55;color:#a79eac}.phase-step button{position:absolute;left:13px;right:13px;bottom:13px;border:0;border-radius:10px;padding:9px;background:#d9b86d12;color:var(--gold2)}
.weather-panel{border-radius:28px;padding:26px;display:grid;grid-template-columns:1fr 1fr;gap:16px}.weather-main .temp{font-family:Georgia,serif;font-size:78px}.weather-main h3{font-family:Georgia,serif;font-size:28px;margin:0}.metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.metric{padding:14px;border-radius:14px;background:#ffffff05}.metric span{font-size:9px;color:#8e8793}.metric b{display:block;margin-top:5px}
.signature{margin-top:65px;border:1px solid #9e7c4850;border-radius:26px;padding:28px;text-align:center;background:radial-gradient(circle at 50% 0,#d9b86d12,transparent 55%),#0d0b12;box-shadow:0 25px 70px #0009}.signature .sigil{font-size:30px;color:var(--gold2)}.signature strong{display:block;font-family:Georgia,serif;font-size:clamp(22px,3vw,36px);line-height:1.25;margin:12px auto;max-width:850px}.signature b{font-size:11px;letter-spacing:.18em;color:var(--gold2)}
.mobile-nav{display:none}.modal{position:fixed;inset:0;z-index:100;display:none;place-items:center;padding:18px}.modal.open{display:grid}.backdrop{position:absolute;inset:0;background:#020204d9;backdrop-filter:blur(15px)}.dialog{position:relative;width:min(520px,100%);max-height:92vh;overflow:auto;border-radius:25px;padding:27px}.close{position:absolute;right:14px;top:13px;width:36px;height:36px;border:0;border-radius:50%;background:#ffffff0a;color:#ddd}.dialog label{display:grid;gap:7px;margin:12px 0;font-size:10px;color:#aaa}.dialog input,.dialog select,.dialog textarea{width:100%;border:1px solid var(--line);background:#0d0b11;color:var(--ink);border-radius:11px;padding:13px}.two{display:grid;grid-template-columns:1fr 1fr;gap:9px}.lang-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:18px}.lang-card{border:1px solid var(--line);border-radius:16px;background:#ffffff05;color:var(--ink);padding:15px;text-align:left;display:flex;gap:12px;align-items:center}.lang-card.active{border-color:#c99f58;background:#2a2018}.flag{font-size:29px;animation:flag 2.8s ease-in-out infinite;transform-origin:left center}@keyframes flag{50%{transform:perspective(100px) rotateY(15deg) translateY(-2px)}}.toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,20px);opacity:0;z-index:200;background:#17131d;border:1px solid var(--line);border-radius:999px;padding:12px 18px;transition:.25s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:1050px){.shell{grid-template-columns:1fr}.rail{display:none}.hero{grid-template-columns:1fr;min-height:auto;padding-top:55px}.hero-copy{text-align:center}.hero-copy p{margin-inline:auto}.actions{justify-content:center}.sphere-wrap{min-height:590px}.navigator,.lunar-story{grid-template-columns:1fr}.mobile-nav{display:grid;position:fixed;left:12px;right:12px;bottom:calc(10px + env(safe-area-inset-bottom));z-index:60;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:20px;padding:8px;background:#0c0a11e8;backdrop-filter:blur(18px)}.mobile-nav button{border:0;background:transparent;color:#918996;padding:8px;font-size:10px}.mobile-nav b{display:block;font-size:20px;color:var(--gold2);margin-bottom:3px}.topbar{padding-top:env(safe-area-inset-top)}main{padding-bottom:115px}}
@media(max-width:700px){main{padding-inline:16px}.topbar .brand small{display:none}.hero{padding-top:30px}.clock{font-size:75px}.hero-copy h2{font-size:42px}.sphere-wrap{min-height:480px}.sphere{width:min(94vw,500px)}.planet-orb{width:90px;height:90px}.planet-orb b{font-size:38px}.ribbon{width:156px;left:0}.ribbon strong{font-size:17px}.now-panel{grid-template-columns:1fr;min-height:auto}.planet-seal{width:130px;height:130px;font-size:65px}.explain{grid-template-columns:1fr}.phase-rail{display:flex;overflow:auto;scroll-snap-type:x mandatory;padding-bottom:10px}.phase-step{flex:0 0 82%;scroll-snap-align:center}.weather-panel{grid-template-columns:1fr}.section{padding:48px 0}.section-head{display:block}.signature{padding:22px 16px}.lang-grid{grid-template-columns:1fr}.modal{align-items:end;padding:0}.dialog{width:100%;border-radius:25px 25px 0 0}}

/* ===== LUNARIS v15: true mobile-first responsive layer ===== */
html, body { width: 100%; max-width: 100%; overflow-x: hidden; }
img, canvas, svg { max-width: 100%; }
button, input, select, textarea { min-width: 0; }
main { min-width: 0; }
section { scroll-margin-top: 20px; }

@media (max-width: 1050px) {
  body { padding-bottom: calc(92px + env(safe-area-inset-bottom)); }
  .shell { display: block; }
  .rail { display: none !important; }
  main {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding:
      calc(12px + env(safe-area-inset-top))
      14px
      calc(118px + env(safe-area-inset-bottom));
  }

  .topbar {
    position: sticky;
    top: 8px;
    z-index: 55;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 17px;
    background: rgba(10, 8, 15, .82);
    backdrop-filter: blur(18px);
    box-shadow: 0 16px 40px rgba(0,0,0,.28);
  }
  .brand h1 { font-size: 17px; letter-spacing: .16em; }
  .status {
    max-width: 52%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding: 8px 10px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    min-height: 0;
    gap: 22px;
    padding: 32px 0 24px;
  }
  .hero-copy {
    width: 100%;
    text-align: left;
    order: 1;
  }
  .hero-copy .eyebrow { font-size: 9px; }
  .clock {
    font-size: clamp(58px, 19vw, 94px);
    line-height: .96;
    letter-spacing: -.055em;
    margin-top: 8px;
  }
  .date { margin-top: 8px; font-size: 9px; line-height: 1.5; }
  .hero-copy h2 {
    font-size: clamp(34px, 10vw, 51px);
    margin: 28px 0 13px;
    max-width: 12ch;
  }
  .hero-copy p {
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }
  .actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 20px;
  }
  .primary, .ghost {
    width: 100%;
    min-height: 52px;
    padding: 14px 16px;
    border-radius: 15px;
    font-size: 15px;
  }

  .sphere-wrap {
    order: 2;
    width: 100%;
    min-height: auto;
    padding: 6px 0 0;
  }
  .sphere {
    width: min(92vw, 480px);
    max-width: 100%;
    margin-inline: auto;
  }
  .moon { width: 50%; }
  .core .phase { font-size: clamp(17px, 5.5vw, 25px); }
  .core .illum { font-size: 9px; }
  .planet-orb {
    width: 82px;
    height: 82px;
    right: 2%;
    bottom: 11%;
  }
  .planet-orb b { font-size: 34px; }
  .planet-orb span { bottom: 9px; font-size: 7px; }
  .ribbon {
    left: 0;
    bottom: 5%;
    width: min(43vw, 165px);
    padding: 12px;
  }
  .ribbon strong { font-size: 16px; }
  .ribbon span { font-size: 8px; }

  .section { padding: 42px 0; }
  .section-head { display: block; margin-bottom: 18px; }
  .section-head h2 {
    font-size: clamp(31px, 9vw, 46px);
    line-height: 1.02;
    margin: 7px 0 10px;
  }
  .section-head p { font-size: 13px; line-height: 1.65; }

  .intent-dock {
    margin-inline: -14px;
    padding: 4px 14px 13px;
    scroll-padding-left: 14px;
  }
  .intent-dock button {
    min-height: 42px;
    padding: 10px 14px;
    font-size: 12px;
  }

  .navigator {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .now-panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    gap: 18px;
    padding: 20px;
    border-radius: 22px;
  }
  .planet-seal {
    width: 108px;
    height: 108px;
    font-size: 56px;
    align-self: flex-start;
  }
  .now-info { width: 100%; min-width: 0; }
  .now-info h3 {
    font-size: clamp(31px, 9vw, 42px);
    line-height: 1.02;
    overflow-wrap: anywhere;
  }
  .time-window { font-size: 12px; }
  .strength { margin: 14px 0; }
  .strength span { font-size: 9px; padding: 7px 9px; }
  .explain {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .explain div { padding: 13px; }
  .explain p { font-size: 12px; }
  .progress { margin: 16px 0; }

  .next-panel {
    padding: 20px;
    border-radius: 22px;
    min-height: 0;
  }
  .next-panel h3 { font-size: 30px; }
  .next-time { font-size: 47px; }
  .why { font-size: 12px; }
  .mini-hour { grid-template-columns: 38px minmax(0,1fr) auto; }

  .daywheel {
    padding: 18px 14px;
    border-radius: 22px;
  }
  .wheel-track {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(132px, 42vw);
    gap: 9px;
    margin-inline: -2px;
    padding-bottom: 13px;
  }
  .hour-node {
    min-height: 142px;
    padding: 12px;
  }
  .hour-node.current { transform: none; }

  .lunar-story {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .moon-timeline, .weather-panel {
    border-radius: 22px;
    padding: 18px;
  }
  .phase-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(78vw, 310px);
    grid-template-columns: none;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 8px 2px 14px;
  }
  .phase-step {
    min-height: 230px;
    scroll-snap-align: center;
    padding: 18px;
  }
  .phase-step.active { transform: none; }
  .phase-step h4 { font-size: 23px; }
  .phase-step p { font-size: 12px; }

  .weather-panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .weather-main .temp { font-size: 74px; }
  .metrics { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .metric { min-width: 0; }
  .metric b { overflow-wrap: anywhere; }

  #planner .section-head .primary { margin-top: 15px; }
  #practiceList { padding: 16px !important; border-radius: 22px !important; }

  .signature {
    margin-top: 46px;
    padding: 24px 16px;
    border-radius: 22px;
  }
  .signature strong {
    font-size: clamp(23px, 7vw, 34px);
    line-height: 1.2;
  }
  .signature b {
    display: block;
    margin-top: 12px;
    font-size: 9px;
    line-height: 1.6;
  }

  .mobile-nav {
    display: grid;
    position: fixed;
    left: 10px;
    right: 10px;
    bottom: calc(8px + env(safe-area-inset-bottom));
    z-index: 90;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 3px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgba(10, 8, 15, .92);
    backdrop-filter: blur(20px);
    box-shadow: 0 22px 65px rgba(0,0,0,.55);
  }
  .mobile-nav button {
    min-width: 0;
    min-height: 54px;
    padding: 7px 3px;
    border-radius: 13px;
    font-size: 9px;
    line-height: 1.15;
  }
  .mobile-nav b { font-size: 19px; }

  .modal { align-items: end; padding: 0; }
  .dialog {
    width: 100%;
    max-height: 88dvh;
    padding: 25px 17px calc(20px + env(safe-area-inset-bottom));
    border-radius: 25px 25px 0 0;
  }
  .dialog h2 { font-size: 32px; margin-right: 42px; }
  .two { grid-template-columns: 1fr; }
  .lang-grid { grid-template-columns: 1fr; }
  .lang-card { min-height: 60px; }
}

@media (max-width: 390px) {
  main { padding-inline: 11px; }
  .topbar { padding: 9px 10px; }
  .brand h1 { font-size: 15px; }
  .status { max-width: 48%; font-size: 8px; }
  .clock { font-size: 61px; }
  .hero-copy h2 { font-size: 36px; }
  .hero-copy p { font-size: 13px; }
  .sphere { width: 96vw; margin-left: 50%; transform: translateX(-50%); }
  .ribbon { width: 150px; }
  .planet-orb { width: 74px; height: 74px; }
  .planet-orb b { font-size: 31px; }
  .phase-rail { grid-auto-columns: 86vw; }
  .wheel-track { grid-auto-columns: 145px; }
  .metrics { grid-template-columns: 1fr 1fr; gap: 7px; }
  .metric { padding: 11px; }
}

@media (min-width: 1051px) {
  .mobile-nav { display: none !important; }
  .hero { min-height: 720px; }
  .now-panel { align-items: center; }
}


@media(max-width:1050px){
  .topbar{position:sticky}
  .mobile-top-actions{display:flex!important;gap:7px}
  .mobile-top-actions button{width:38px;height:38px;border:1px solid var(--line);border-radius:12px;background:#ffffff08;color:var(--gold2)}
  .topbar>.status{margin-left:auto}
}
@media(max-width:560px){
  .topbar>.status{display:none}
}


/* ===== LUNARIS 0.9.1 final readability and install polish ===== */
:root{
  --ink:#f1ece4;
  --muted:#b8b1bd;
  --line:#ffffff20;
  --panel:#121019ee;
  --panel2:#191620ee;
}
body{
  font-size:16px;
  line-height:1.6;
  text-rendering:optimizeLegibility;
  -webkit-font-smoothing:antialiased;
}
p, .why, .phase-step p, .explain p, .weather-main p, .dialog p{
  color:#c4bdc8;
  line-height:1.72;
  letter-spacing:.005em;
}
.eyebrow{
  letter-spacing:.16em;
  line-height:1.45;
}
.glass{
  background:linear-gradient(145deg,rgba(25,22,31,.96),rgba(14,12,19,.97));
  border-color:rgba(255,255,255,.10);
}
.section-head p{max-width:760px}
.now-info h3,.section-head h2,.next-panel h3,.phase-step h4{
  text-wrap:balance;
}
.explain div,.metric,.mini-hour,.phase-step,.hour-node{
  background:rgba(255,255,255,.055);
}
.explain p,.phase-step p,.hour-node small,.mini-hour span{
  font-size:12px;
}
.hour-node b{font-size:13px}
.hour-node time{font-size:10px}
.signature{
  background:
    radial-gradient(circle at 50% 0,rgba(223,189,112,.12),transparent 55%),
    rgba(13,11,18,.97);
}
.signature strong{
  font-weight:700;
  color:#f4eee4;
}
.version-mark{
  display:block;
  margin-top:12px;
  color:#9991a0;
  font-size:10px;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.brand small{color:#aaa2af}

.install-cta{
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  overflow:hidden;
  border-color:rgba(223,189,112,.36);
  background:
    linear-gradient(135deg,rgba(223,189,112,.16),rgba(255,255,255,.055));
  box-shadow:0 14px 44px rgba(190,146,62,.16);
  animation:installGlow 3.2s ease-in-out infinite;
}
.install-cta:before{
  content:"";
  position:absolute;
  inset:-2px;
  background:linear-gradient(110deg,transparent 20%,rgba(255,255,255,.20) 45%,transparent 70%);
  transform:translateX(-120%);
  animation:installSweep 4s ease-in-out infinite;
}
.install-cta>*{position:relative;z-index:1}
.install-cta-icon{
  width:34px;height:34px;border-radius:50%;
  display:grid;place-items:center;
  background:rgba(223,189,112,.17);
  color:var(--gold2);
  font-size:20px;
  animation:installArrow 1.8s ease-in-out infinite;
}
.install-cta b,.install-cta small{display:block;text-align:left}
.install-cta b{font-size:14px;color:#f4eee4}
.install-cta small{font-size:9px;color:#aaa2ae;margin-top:2px}
.install-mini,.install-mobile{
  position:relative;
  overflow:hidden;
  border-color:rgba(223,189,112,.34)!important;
  box-shadow:0 0 0 0 rgba(223,189,112,.26);
  animation:installPulse 2.7s ease-out infinite;
}
.install-mini span,.install-mobile span{
  display:inline-block;
  animation:installArrow 1.8s ease-in-out infinite;
}
.install-lead{
  margin-top:-8px;
  margin-bottom:18px;
  color:#bdb5c1;
}
.install-modal-btn{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  animation:installGlow 3.2s ease-in-out infinite;
}
.install-modal-btn span{animation:installArrow 1.8s ease-in-out infinite}
@keyframes installGlow{
  0%,100%{box-shadow:0 12px 38px rgba(190,146,62,.13)}
  50%{box-shadow:0 16px 50px rgba(223,189,112,.28)}
}
@keyframes installSweep{
  0%,55%{transform:translateX(-120%)}
  85%,100%{transform:translateX(120%)}
}
@keyframes installArrow{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(4px)}
}
@keyframes installPulse{
  0%{box-shadow:0 0 0 0 rgba(223,189,112,.22)}
  65%{box-shadow:0 0 0 10px rgba(223,189,112,0)}
  100%{box-shadow:0 0 0 0 rgba(223,189,112,0)}
}

/* Language selector: code first, then flag, then full name */
.lang-card{
  min-height:66px;
  display:grid;
  grid-template-columns:46px 40px minmax(0,1fr);
  gap:10px;
  align-items:center;
  padding:13px 14px;
}
.lang-code{
  font-weight:900;
  color:var(--gold2);
  letter-spacing:.08em;
  font-size:15px;
}
.lang-card .flag{
  font-size:27px;
  text-align:center;
}
.lang-name b{
  display:block;
  color:#eee8df;
  font-size:13px;
}
.lang-name small{
  display:block;
  color:#9d95a2;
  font-size:9px;
  margin-top:2px;
}
.lang-card.active{
  box-shadow:inset 0 0 0 1px rgba(223,189,112,.24),0 12px 30px rgba(0,0,0,.24);
}

@media(max-width:1050px){
  body{font-size:15px}
  .hero-copy p,.section-head p{font-size:14px}
  .explain p,.phase-step p,.why{font-size:13px}
  .now-panel,.next-panel,.moon-timeline,.weather-panel,.daywheel{
    box-shadow:0 18px 48px rgba(0,0,0,.35);
  }
  .hour-node small{font-size:10px}
  .signature strong{font-size:clamp(22px,6.7vw,32px)}
}
@media(max-width:390px){
  body{font-size:14px}
  .hero-copy p,.section-head p{font-size:13px}
  .lang-card{grid-template-columns:42px 36px minmax(0,1fr)}
}
@media(prefers-reduced-motion:reduce){
  .install-cta,.install-mini,.install-mobile,.install-modal-btn,
  .install-cta:before,.install-cta-icon,.install-mini span,.install-mobile span,.install-modal-btn span{
    animation:none!important;
  }
}


#langBtn,#mobileLangBtn{font-size:22px;line-height:1;padding:0;display:grid;place-items:center}
#langBtn{width:54px}
#mobileLangBtn{width:42px}
.ios-install-steps{display:grid;gap:9px;margin:16px 0}
.ios-install-steps[hidden]{display:none}
.ios-install-steps div{display:grid;grid-template-columns:34px 1fr;gap:10px;align-items:center;padding:11px;border:1px solid var(--line);border-radius:12px;background:#ffffff08}
.ios-install-steps b{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:rgba(223,189,112,.16);color:var(--gold2)}


/* ===== Lunar month cycle 0.9.3 ===== */
.lunar-month{
  border-radius:28px;
  padding:26px;
  overflow:hidden;
}
.lunar-month-summary{
  display:grid;
  grid-template-columns:1fr auto;
  gap:20px;
  align-items:end;
}
.lunar-month-summary h3{
  font-family:Georgia,serif;
  font-size:clamp(32px,4vw,48px);
  margin:7px 0 8px;
}
.lunar-month-summary p{margin:0;color:#bfb7c3}
.lunar-countdown{
  min-width:220px;
  padding:16px 18px;
  border:1px solid var(--line);
  border-radius:17px;
  background:rgba(255,255,255,.05);
  text-align:right;
}
.lunar-countdown small{display:block;color:#9c94a2;font-size:9px;letter-spacing:.08em}
.lunar-countdown strong{display:block;margin-top:6px;font-family:Georgia,serif;font-size:27px;color:var(--gold2)}
.lunar-cycle-track{
  position:relative;
  height:210px;
  margin:34px 4px 18px;
}
.lunar-cycle-line,.lunar-cycle-progress{
  position:absolute;
  left:4%;right:4%;top:82px;height:3px;border-radius:99px;
}
.lunar-cycle-line{background:rgba(255,255,255,.11)}
.lunar-cycle-progress{
  right:auto;
  width:0;
  background:linear-gradient(90deg,#9c6b38,#efd48d);
  box-shadow:0 0 20px rgba(223,189,112,.45);
  transition:width .8s ease;
}
.lunar-cycle-marker{
  position:absolute;
  left:4%;top:65px;
  width:36px;height:36px;
  border:1px solid rgba(223,189,112,.65);
  border-radius:50%;
  background:#0b0910;
  transform:translateX(-50%);
  box-shadow:0 0 28px rgba(223,189,112,.38);
  transition:left .8s ease;
  z-index:4;
}
.lunar-cycle-marker span{
  position:absolute;inset:8px;border-radius:50%;
  background:radial-gradient(circle at 35% 35%,#fff1c7,#a1844d 70%,#392d1c);
  animation:moonBreath 4s ease-in-out infinite;
}
.lunar-point{
  position:absolute;
  left:calc(4% + var(--x)*.92);
  top:38px;
  width:150px;
  transform:translateX(-50%);
  border:0;
  background:transparent;
  color:var(--ink);
  text-align:center;
  padding:0;
}
.lunar-point i{
  display:grid;
  place-items:center;
  width:50px;height:50px;
  margin:auto;
  border:1px solid var(--line);
  border-radius:50%;
  background:#121019;
  color:var(--gold2);
  font-size:26px;
}
.lunar-point b{display:block;margin-top:44px;font-size:12px}
.lunar-point time{display:block;margin-top:5px;color:#9f97a5;font-size:9px}
.lunar-key-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:10px;
}
.lunar-key-card{
  min-width:0;
  padding:16px;
  border:1px solid var(--line);
  border-radius:16px;
  background:rgba(255,255,255,.045);
}
.lunar-key-card span{font-size:9px;color:#958e9b}
.lunar-key-card b{display:block;margin-top:7px;font-size:15px;color:#eee7dc}
.lunar-key-card small{display:block;margin-top:5px;font-size:9px;color:var(--gold2)}
.lunar-meaning{
  margin-top:14px;
  padding:17px;
  border-left:2px solid var(--gold);
  background:rgba(223,189,112,.055);
}
.lunar-meaning p{margin:7px 0 0;color:#c5bdc8;line-height:1.7}

@media(max-width:760px){
  .lunar-month{padding:19px;border-radius:22px}
  .lunar-month-summary{grid-template-columns:1fr;align-items:stretch}
  .lunar-countdown{text-align:left;min-width:0}
  .lunar-cycle-track{
    height:300px;
    margin:24px 0 12px;
  }
  .lunar-cycle-line,.lunar-cycle-progress{left:28px;right:auto;top:12px;bottom:12px;width:3px;height:auto}
  .lunar-cycle-progress{height:0;bottom:auto;transition:height .8s ease}
  .lunar-cycle-marker{
    left:11px!important;
    top:12px;
    transform:translateY(-50%);
    transition:top .8s ease;
  }
  .lunar-point{
    left:0!important;
    top:calc(12px + var(--x)*2.55);
    width:100%;
    transform:none;
    display:grid;
    grid-template-columns:52px 1fr auto;
    gap:12px;
    align-items:center;
    text-align:left;
  }
  .lunar-point i{margin:0;width:44px;height:44px}
  .lunar-point b{margin:0;font-size:13px}
  .lunar-point time{margin:0;text-align:right;font-size:10px}
  .lunar-key-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:420px){
  .lunar-key-grid{grid-template-columns:1fr}
}


.forest-horizon{position:fixed;left:0;right:0;bottom:0;height:31vh;z-index:-4;opacity:.68;background:linear-gradient(to top,#030406 0 24%,transparent 25%),repeating-linear-gradient(73deg,transparent 0 30px,#050609 31px 38px,transparent 39px 66px);clip-path:polygon(0 48%,4% 31%,7% 54%,11% 19%,14% 52%,18% 34%,22% 58%,27% 17%,31% 51%,36% 29%,41% 57%,46% 14%,51% 49%,56% 27%,61% 56%,66% 18%,71% 50%,76% 31%,81% 58%,86% 19%,91% 49%,96% 29%,100% 53%,100% 100%,0 100%)}
.cinematic-fog{position:fixed;left:-20%;right:-20%;bottom:-7%;height:44vh;z-index:-3;background:radial-gradient(ellipse at center,#d8ccdc1a,transparent 66%);filter:blur(38px);animation:fogDrift 25s ease-in-out infinite alternate}@keyframes fogDrift{to{transform:translateX(9%) scale(1.08);opacity:.75}}
.moon-coordinates{position:absolute;right:0;top:10%;width:145px;padding:12px;border:1px solid var(--line);border-radius:15px;background:#0d0b12d6;backdrop-filter:blur(15px)}.moon-coordinates span,.moon-coordinates small{display:block;font-size:8px;color:#9991a0}.moon-coordinates b{display:block;font:500 22px Georgia,serif;margin:5px 0;color:var(--gold2)}.moon-coordinates i{font-style:normal}
.planet-hall{display:grid;grid-template-columns:minmax(430px,1.15fr) .85fr;gap:18px;border-radius:28px;padding:22px}.planetarium{position:relative;min-height:560px;border:1px solid var(--line);border-radius:22px;overflow:hidden;background:radial-gradient(circle at 50% 48%,#332440,#0b0a11 64%)}#aspectCanvas{position:absolute;inset:0;width:100%;height:100%}
.planet-node{position:absolute;width:76px;height:76px;border:1px solid #d0ac6757;border-radius:50%;background:#0d0b13e8;display:grid;place-items:center;transform:translate(-50%,-50%);box-shadow:0 12px 35px #0009;transition:.25s}.planet-node:hover,.planet-node.active{border-color:#f0cf83;transform:translate(-50%,-50%) scale(1.1);box-shadow:0 0 35px #d7ad6042}.planet-node b{font-size:30px;color:var(--gold2)}.planet-node small{position:absolute;bottom:8px;font-size:7px;color:#a79fac}
.planet-inspector{border-radius:22px;padding:22px;background:#ffffff04}.planet-inspector h3{font:500 42px Georgia,serif;margin:8px 0}.planet-stats{display:grid;grid-template-columns:1fr 1fr;gap:9px}.planet-stats div{padding:12px;border-radius:12px;background:#ffffff05}.planet-stats span{font-size:8px;color:#918a98}.planet-stats b{display:block;margin-top:5px;font-size:13px}.planet-history{margin-top:15px;padding:15px;border-left:2px solid var(--gold);background:#d9b86d09;color:#bdb5c1;font-size:11px;line-height:1.7}
@media(max-width:1050px){.planet-hall{grid-template-columns:1fr;padding:18px}.planetarium{min-height:430px}.planet-node{width:62px;height:62px}.planet-node b{font-size:24px}.planet-inspector h3{font-size:35px}.moon-coordinates{width:122px;right:0;top:2%}.mobile-nav{grid-template-columns:repeat(5,1fr)}}
@media(max-width:430px){.planetarium{min-height:380px}.planet-stats{grid-template-columns:1fr}.moon-coordinates{top:auto;bottom:27%;right:-2px}}

</style>
</head>
<body>
<div class="bg"></div><canvas id="stars"></canvas><div class="veil"></div><div class="forest-horizon"></div><div class="cinematic-fog"></div>
<div class="shell">
<aside class="rail">
<div class="logo">☾</div>
<nav><button class="navbtn active" data-go="today">◐</button><button class="navbtn" data-go="hours">♄</button><button class="navbtn" data-go="planets">✧</button><button class="navbtn" data-go="moon">☽</button><button class="navbtn" data-go="planner">✦</button></nav>
<div class="rail-bottom"><button class="mini" id="langBtn">RU</button><button class="mini install-mini" id="installBtn" aria-label="Установить приложение"><span>↓</span></button></div>
</aside>
<main>
<header class="topbar"><div class="brand"><h1>LUNARIS</h1><small>VERBUM DAEMONIS · версия 1.0.0</small></div><div class="status"><span class="dot"></span><span id="status">Определяем местоположение…</span></div>
<div class="mobile-top-actions" style="display:none">
  <button id="mobileLangBtn" aria-label="Выбрать язык">🌐</button>
  <button id="mobileInstallBtn" class="install-mobile" aria-label="Установить приложение"><span>↓</span></button>
</div>
</header>

<section id="today" class="hero">
<div class="hero-copy">
<div class="eyebrow" id="heroEyebrow">ЖИВОЙ РИТУАЛЬНЫЙ НАВИГАТОР</div>
<div class="clock" id="clock">--:--</div><div class="date" id="date">—</div>
<h2 id="heroTitle">Видеть <em>время силы</em>, а не таблицу</h2>
<p id="heroText">Выберите намерение — LUNARIS соединит фазу Луны, планетарный час, световой день и местные условия в одно понятное окно для практики.</p>
<div class="actions"><button class="primary" id="quickPlan">＋ Запланировать</button><button class="ghost install-cta" data-install><span class="install-cta-icon">↓</span><span><b>Установить LUNARIS</b><small>На телефон или компьютер</small></span></button></div>
</div>
<div class="sphere-wrap">
<div class="sphere">
<div class="ticks"></div><div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div><div class="ring r4"></div>
<div class="moon"><div class="shadow" id="moonShadow"></div></div>
<div class="core"><div class="phase" id="moonPhase">—</div><div class="illum"><span id="moonPct">—</span> освещённости</div></div>
<div class="planet-orb"><b id="orbSeal">♄</b><span id="orbName">САТУРН</span></div>
<div class="ribbon"><small>ТЕКУЩЕЕ ОКНО</small><strong id="orbRange">—</strong><span id="orbRemain">расчёт…</span></div><div class="moon-coordinates"><span>Высота Луны</span><b id="moonAltitude">—°</b><small>азимут <i id="moonAzimuth">—°</i></small></div>
</div>
</div>
</section>


<section id="planets" class="section">
<div class="section-head"><div><div class="eyebrow">ПЛАНЕТАРНЫЙ ЗАЛ</div><h2>Семь традиционных светил</h2><p>Положение в знаках, высота, азимут, традиционные сферы, металлы и основные аспекты.</p></div></div>
<div class="planet-hall glass">
  <div class="planetarium" id="planetarium"><canvas id="aspectCanvas"></canvas></div>
  <article class="planet-inspector">
    <div class="eyebrow">ВЫБРАННОЕ СВЕТИЛО</div>
    <h3 id="planetDetailName">Сатурн</h3>
    <div class="strength" id="planetDetailTags"></div>
    <div class="planet-stats">
      <div><span>Знак</span><b id="planetSign">—</b></div>
      <div><span>Долгота</span><b id="planetLongitude">—</b></div>
      <div><span>Высота</span><b id="planetAltitude">—</b></div>
      <div><span>Азимут</span><b id="planetAzimuth">—</b></div>
      <div><span>Металл</span><b id="planetMetal">—</b></div>
      <div><span>Сфера</span><b id="planetSphere">—</b></div>
    </div>
    <div class="planet-history" id="planetHistory">—</div>
  </article>
</div>
</section>

<section id="hours" class="section">
<div class="section-head"><div><div class="eyebrow" id="hoursEyebrow">РИТУАЛЬНЫЙ КОМПАС</div><h2 id="hoursTitle">Что вы хотите совершить?</h2><p id="hoursText">После выбора LUNARIS выделит подходящие часы и покажет ближайшее сильное окно.</p></div></div>
<div class="intent-dock" id="intentDock"></div>
<div class="navigator">
<article class="now-panel glass">
<div class="planet-seal" id="currentSeal">♄</div>
<div class="now-info"><div class="eyebrow">СЕЙЧАС</div><h3 id="currentTitle">Час Сатурна</h3><div class="time-window" id="currentRange">—</div><div class="strength" id="currentPowers"></div>
<div class="explain"><div class="good"><b>✓ ПОДХОДИТ</b><p id="currentWorks">—</p></div><div class="avoid"><b>× НЕ СООТВЕТСТВУЕТ</b><p id="currentAvoid">—</p></div></div>
<div class="progress"><span id="hourProgress"></span></div><button class="primary" id="planCurrent">Запланировать в этот час →</button></div>
</article>
<article class="next-panel glass"><div class="eyebrow" id="nextEyebrow">СЛЕДУЮЩЕЕ СИЛЬНОЕ ОКНО</div><h3 id="nextTitle">—</h3><div class="next-time" id="nextTime">—</div><div class="why" id="nextWhy">Выберите намерение.</div><button class="primary" id="planNext">Запланировать →</button><div class="mini-cycle" id="miniCycle"></div></article>
</div>
<div class="daywheel glass" style="margin-top:16px"><div class="eyebrow" id="wheelEyebrow">КРУГ СУТОК · 24 ПЛАНЕТАРНЫХ ЧАСА</div><div class="wheel-track" id="dayWheel"></div></div>
</section>

<section id="moon" class="section">
<div class="section-head"><div><div class="eyebrow" id="moonEyebrow">ЛУННЫЙ ПУТЬ</div><h2 id="moonTitle">Четыре состояния силы</h2><p id="moonText">Не перечень современных советов, а традиционный ритм: сокрытие, прибавление, полнота и убывание.</p></div></div>
<div class="lunar-story">
<article class="moon-timeline glass"><div class="phase-rail" id="phaseRail"></div></article>
<article class="weather-panel glass"><div class="weather-main"><div class="eyebrow">МЕСТНЫЕ УСЛОВИЯ</div><div class="temp" id="temp">—°</div><h3 id="weatherText">Ожидание данных</h3><p id="place" style="color:#999">Ваше местоположение</p></div><div class="metrics"><div class="metric"><span>Ощущается</span><b id="feels">—°</b></div><div class="metric"><span>Ветер</span><b id="wind">—</b></div><div class="metric"><span>Влажность</span><b id="humidity">—</b></div><div class="metric"><span>Давление</span><b id="pressure">—</b></div></div></article>
</div>
</section>


<section id="lunarMonth" class="section">
  <div class="section-head">
    <div>
      <div class="eyebrow">ХОД ЛУННОГО МЕСЯЦА</div>
      <h2>От фазы к фазе</h2>
      <p>Текущий этап, ближайший переход и четыре ключевые точки лунного месяца.</p>
    </div>
  </div>

  <article class="lunar-month glass">
    <div class="lunar-month-summary">
      <div>
        <span class="eyebrow">СЕЙЧАС</span>
        <h3 id="lunarCurrentPhase">—</h3>
        <p id="lunarTransitionText">—</p>
      </div>
      <div class="lunar-countdown">
        <small id="lunarNextLabel">До следующего перехода</small>
        <strong id="lunarNextCountdown">—</strong>
      </div>
    </div>

    <div class="lunar-cycle-track" aria-label="Ход лунного месяца">
      <div class="lunar-cycle-line"></div>
      <div class="lunar-cycle-progress" id="lunarCycleProgress"></div>
      <div class="lunar-cycle-marker" id="lunarCycleMarker"><span></span></div>
      <button class="lunar-point" data-point="new" style="--x:0%">
        <i>●</i><b>Новолуние</b><time id="newMoonDate">—</time>
      </button>
      <button class="lunar-point" data-point="first" style="--x:25%">
        <i>◐</i><b>Первая четверть</b><time id="firstQuarterDate">—</time>
      </button>
      <button class="lunar-point" data-point="full" style="--x:50%">
        <i>○</i><b>Полнолуние</b><time id="fullMoonDateExact">—</time>
      </button>
      <button class="lunar-point" data-point="last" style="--x:75%">
        <i>◑</i><b>Последняя четверть</b><time id="lastQuarterDate">—</time>
      </button>
    </div>

    <div class="lunar-key-grid">
      <div class="lunar-key-card">
        <span>Ближайшее новолуние</span>
        <b id="nextNewMoon">—</b>
        <small id="toNewMoon">—</small>
      </div>
      <div class="lunar-key-card">
        <span>Ближайшее полнолуние</span>
        <b id="nextFullMoon">—</b>
        <small id="toFullMoon">—</small>
      </div>
      <div class="lunar-key-card">
        <span>Возраст Луны</span>
        <b id="moonAge">—</b>
        <small id="moonCycleDay">—</small>
      </div>
      <div class="lunar-key-card">
        <span>Направление цикла</span>
        <b id="moonDirection">—</b>
        <small id="moonDirectionNote">—</small>
      </div>
    </div>

    <div class="lunar-meaning" id="lunarMeaning">
      <span class="eyebrow">ВАЖНО ДЛЯ ПРАКТИКИ</span>
      <p id="lunarMeaningText">—</p>
    </div>
  </article>
</section>

<section id="planner" class="section">
<div class="section-head"><div><div class="eyebrow" id="plannerEyebrow">ВАШИ ПРАКТИКИ</div><h2 id="plannerTitle">Ничего лишнего</h2><p id="plannerText">Название, дата, время и напоминание за час.</p></div><button class="primary" id="addPlan">＋ Добавить</button></div>
<div class="glass" style="border-radius:26px;padding:24px" id="practiceList"></div>
</section>

<footer class="signature"><div class="sigil">☾ ✦ ♄</div><strong>Цифровой инструмент для планирования<br>ритуально-обрядовых практик</strong><b>РАЗРАБОТАНО ОРДЕНОМ VERBUM DAEMONIS</b><span class="version-mark">Версия приложения 1.0.0</span></footer>
</main>
</div>

<nav class="mobile-nav"><button data-go="today"><b>◐</b>Сейчас</button><button data-go="hours"><b>♄</b>Часы</button><button data-go="planets"><b>✧</b>Планеты</button><button data-go="moon"><b>☽</b>Луна</button><button data-go="planner"><b>✦</b>План</button></nav>

<div class="modal" id="planModal"><div class="backdrop" data-close-plan></div><form class="dialog glass" id="planForm"><button type="button" class="close" data-close-plan>×</button><div class="eyebrow">НОВАЯ ПРАКТИКА</div><h2>Выберите время</h2><label>Название<input id="pTitle" required placeholder="Например: очищение пространства"></label><div class="two"><label>Дата<input id="pDate" type="date" required></label><label>Время<input id="pTime" type="time" required></label></div><label>Направление<select id="pType"></select></label><label>Заметка<textarea id="pNote" rows="3"></textarea></label><label style="display:flex;grid-template-columns:auto 1fr;align-items:center"><input id="pReminder" type="checkbox" checked style="width:auto"> Напомнить за 1 час</label><button class="primary" style="width:100%">Сохранить</button></form></div>
<div class="modal" id="langModal"><div class="backdrop" data-close-lang></div><div class="dialog glass"><button class="close" data-close-lang>×</button><div class="eyebrow" id="langEyebrow">ЯЗЫК ПРИЛОЖЕНИЯ</div><h2 id="langTitle">Выберите язык</h2><div class="lang-grid" id="langGrid"></div></div></div>
<div class="modal" id="installModal"><div class="backdrop" data-close-install></div><div class="dialog glass"><button class="close" data-close-install>×</button><div class="eyebrow" id="installEyebrow">УСТАНОВКА PWA</div><h2 id="installTitle">Установите LUNARIS</h2><p class="install-lead" id="installLead">Приложение откроется отдельным значком и будет доступно как обычная программа.</p><p id="installText" style="color:#aaa;line-height:1.7"></p><div id="iosInstallSteps" class="ios-install-steps" hidden><div><b>1</b><span>Откройте сайт именно в Safari</span></div><div><b>2</b><span>Нажмите значок «Поделиться» ⎋</span></div><div><b>3</b><span>Выберите «На экран Домой»</span></div><div><b>4</b><span>Нажмите «Добавить»</span></div></div><button class="primary install-modal-btn" id="nativeInstall" style="width:100%"><span>↓</span> Установить сейчас</button></div></div>
<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/astronomy-engine@2.1.19/astronomy.browser.min.js"></script>
<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const state={lat:null,lon:null,tz:Intl.DateTimeFormat().resolvedOptions().timeZone||'Europe/Warsaw',hours:[],intent:'all',installPrompt:null,nextIndex:0,lang:localStorage.getItem('lunarisLang')||'ru'};
const planetData=[
{n:'Сатурна',short:'САТУРН',s:'♄',powers:['время','предел','земля','предки'],works:'защита, отсечение, связывание, завершение и поминальные действа',avoid:'примирение, лёгкие начинания и быстрый рост',intent:['protection','ending']},
{n:'Юпитера',short:'ЮПИТЕР',s:'♃',powers:['власть','достаток','закон','рост'],works:'достаток, покровительство, статус, расширение и благословение',avoid:'мелочные, скрытые и разрушительные намерения',intent:['wealth','success']},
{n:'Марса',short:'МАРС',s:'♂',powers:['огонь','железо','воля','борьба'],works:'сила, победа, отсечение, защита и преодоление',avoid:'примирение и мягкие согласительные действия',intent:['strength','protection','ending']},
{n:'Солнца',short:'СОЛНЦЕ',s:'☉',powers:['свет','власть','жизнь','ясность'],works:'освящение, успех, здоровье, истина и авторитет',avoid:'скрытые, обманные и подчиняющие действия',intent:['success','healing']},
{n:'Венеры',short:'ВЕНЕРА',s:'♀',powers:['притяжение','красота','согласие','плодородие'],works:'любовь, примирение, союз, красота и творчество',avoid:'жёсткое отсечение и конфликтные действия',intent:['love']},
{n:'Меркурия',short:'МЕРКУРИЙ',s:'☿',powers:['слово','дорога','знание','обмен'],works:'обучение, договоры, торговля, гадание и открытие дорог',avoid:'поспешные клятвы и необдуманные договоры',intent:['knowledge','roads']},
{n:'Луны',short:'ЛУНА',s:'☽',powers:['вода','сны','память','перемена'],works:'сны, прорицание, очищение, память рода и внутренняя работа',avoid:'решения, требующие полной устойчивости',intent:['dreams','cleansing']}
];
const intentions=[['all','Все часы'],['protection','Защита'],['wealth','Достаток'],['love','Согласие'],['knowledge','Познание'],['strength','Сила'],['dreams','Сны'],['ending','Завершение'],['roads','Открытие дорог'],['healing','Жизненная сила'],['cleansing','Очищение']];
const phases=[
{name:'Новолуние',icon:'●',desc:'Сокрытие света. Молчание, пустота, подготовка и зарождение намерения.',works:['очищение места','молчаливое намерение','подготовка орудий','обеты и начало пути']},
{name:'Растущая Луна',icon:'◐',desc:'Прибавление силы. То, что должно расти, укрепляться и входить в жизнь.',works:['достаток','укрепление защиты','развитие дела','привлечение возможностей']},
{name:'Полнолуние',icon:'○',desc:'Полнота и явленность. Кульминация, освящение, прорицание и видение.',works:['освящение предметов','прорицание','работа со снами','завершение накопления силы']},
{name:'Убывающая Луна',icon:'◑',desc:'Уход и истончение. Отсечение, изгнание, очищение и завершение.',works:['отсечение связей','избавление','очищение','закрытие и отпускание']}
];
const SYN=29.530588853,REF=Date.UTC(2000,0,6,18,14),order=[0,1,2,3,4,5,6],dayRulers=[3,6,2,5,1,4,0];
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('show'),2800)}
function fmt(d,opt){return new Intl.DateTimeFormat(tr().locale,{timeZone:state.tz,...opt}).format(new Date(d))}
function moonInfo(d=new Date()){const age=((((d-REF)/864e5)%SYN)+SYN)%SYN,phase=age/SYN,illum=(1-Math.cos(2*Math.PI*phase))/2;let idx=phase<.08||phase>.92?0:phase<.5?1:phase<.58?2:3;return{phase,illum,idx}}
function updateClock(){const n=new Date();$('#clock').textContent=fmt(n,{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});$('#date').textContent=fmt(n,{weekday:'long',day:'numeric',month:'long',year:'numeric'});renderCurrent()}
function renderMoon(){const m=moonInfo(),p=phases[m.idx];$('#moonPhase').textContent=p.name;$('#moonPct').textContent=Math.round(m.illum*100)+'%';const x=m.phase<=.5?100-m.phase*200:-100+(m.phase-.5)*200;$('#moonShadow').style.transform=`translateX(${x}%)`;$('#phaseRail').innerHTML=phases.map((x,i)=>`<article class="phase-step ${i===m.idx?'active':''}"><i>${x.icon}</i><h4>${x.name}</h4><p>${x.desc}</p><button data-phase="${i}">Запланировать</button></article>`).join('')}
function buildHours(rise,set,nextRise){const seqStart=order.indexOf(dayRulers[new Date(rise).getDay()]),seq=Array.from({length:24},(_,i)=>order[(seqStart+i)%7]),dayLen=(set-rise)/12,nightLen=(nextRise-set)/12;state.hours=[];for(let i=0;i<24;i++){const day=i<12,start=day?rise+i*dayLen:set+(i-12)*nightLen,end=start+(day?dayLen:nightLen);state.hours.push({start,end,p:seq[i],day})}renderAll()}
function fallbackHours(){const n=new Date(),y=n.getFullYear(),m=n.getMonth(),d=n.getDate();buildHours(+new Date(y,m,d,6),+new Date(y,m,d,18),+new Date(y,m,d+1,6))}
function currentHour(){return state.hours.find(h=>Date.now()>=h.start&&Date.now()<h.end)||state.hours[0]}
function matching(h){return state.intent==='all'||planetData[h.p].intent.includes(state.intent)}
function renderIntent(){
 const t=tr(),keys=['all','protection','wealth','love','knowledge','strength','dreams','ending','roads','healing','cleansing'],labels=[t.all,...t.intents];
 $('#intentDock').innerHTML=keys.map((k,i)=>`<button class="${state.intent===k?'active':''}" data-intent="${k}">${labels[i]}</button>`).join('')
}
function renderCurrent(){if(!state.hours.length)return;const h=currentHour(),p=planetData[h.p],remaining=Math.max(0,h.end-Date.now());$('#orbSeal').textContent=p.s;$('#orbName').textContent=p.short;$('#orbRange').textContent=`${fmt(h.start,{hour:'2-digit',minute:'2-digit'})}—${fmt(h.end,{hour:'2-digit',minute:'2-digit'})}`;$('#orbRemain').textContent=`ещё ${Math.floor(remaining/60000)} мин`;$('#currentSeal').textContent=p.s;$('#currentTitle').textContent='Час '+p.n;$('#currentRange').textContent=`${fmt(h.start,{hour:'2-digit',minute:'2-digit'})} — ${fmt(h.end,{hour:'2-digit',minute:'2-digit'})}`;$('#currentPowers').innerHTML=p.powers.map(x=>`<span>${x}</span>`).join('');$('#currentWorks').textContent=p.works;$('#currentAvoid').textContent=p.avoid;$('#hourProgress').style.width=Math.min(100,Math.max(0,(Date.now()-h.start)/(h.end-h.start)*100))+'%'}
function renderNext(){const now=Date.now();let idx=state.hours.findIndex(h=>h.start>now&&matching(h));if(idx<0)idx=state.hours.findIndex(matching);state.nextIndex=Math.max(0,idx);const h=state.hours[state.nextIndex],p=planetData[h.p];$('#nextTitle').textContent='Час '+p.n;$('#nextTime').textContent=fmt(h.start,{hour:'2-digit',minute:'2-digit'});$('#nextWhy').textContent=`Силы: ${p.powers.join(', ')}. Подходит для: ${p.works}.`;$('#miniCycle').innerHTML=state.hours.slice(state.nextIndex,state.nextIndex+3).map(x=>{const q=planetData[x.p];return`<div class="mini-hour"><i>${q.s}</i><div><b>${q.short}</b><span>${q.powers.slice(0,2).join(' · ')}</span></div><time>${fmt(x.start,{hour:'2-digit',minute:'2-digit'})}</time></div>`}).join('')}
function renderWheel(){$('#dayWheel').innerHTML=state.hours.map((h,i)=>{const p=planetData[h.p],cur=Date.now()>=h.start&&Date.now()<h.end,mat=matching(h),dim=state.intent!=='all'&&!mat;return`<button class="hour-node ${cur?'current':''} ${mat?'match':''} ${dim?'dim':''}" data-hour="${i}"><span class="sym">${p.s}</span><b>${p.short}</b><time>${fmt(h.start,{hour:'2-digit',minute:'2-digit'})}—${fmt(h.end,{hour:'2-digit',minute:'2-digit'})}</time><small>${p.powers.slice(0,2).join(' · ')}</small></button>`}).join('');setTimeout(()=>$('#dayWheel .current')?.scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'}),100)}
function renderAll(){renderIntent();renderCurrent();renderNext();renderWheel()}
async function locate(){if(!navigator.geolocation){$('#status').textContent='Резервный расчёт';return}navigator.geolocation.getCurrentPosition(async pos=>{state.lat=pos.coords.latitude;state.lon=pos.coords.longitude;$('#status').textContent='Местоположение определено';calculateAstronomy();try{const q=new URLSearchParams({latitude:state.lat,longitude:state.lon,timezone:'auto',forecast_days:'2',current:'temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,surface_pressure,wind_speed_10m',daily:'sunrise,sunset'});const r=await fetch('https://api.open-meteo.com/v1/forecast?'+q);const d=await r.json();state.tz=d.timezone||state.tz;renderWeather(d);buildHours(+new Date(d.daily.sunrise[0]),+new Date(d.daily.sunset[0]),+new Date(d.daily.sunrise[1]));}catch(e){$('#status').textContent='Лунные данные активны'}} ,()=>{$('#status').textContent='Используется резервный расчёт'},{enableHighAccuracy:true,timeout:12000,maximumAge:300000})}
function renderWeather(d){const c=d.current,codes={0:'Ясно',1:'Преимущественно ясно',2:'Переменная облачность',3:'Пасмурно',45:'Туман',51:'Морось',61:'Дождь',63:'Дождь',65:'Сильный дождь',71:'Снег',80:'Ливень',95:'Гроза'};$('#temp').textContent=Math.round(c.temperature_2m)+'°';$('#weatherText').textContent=codes[c.weather_code]||'Атмосферные условия';$('#feels').textContent=Math.round(c.apparent_temperature)+'°';$('#wind').textContent=Math.round(c.wind_speed_10m)+' км/ч';$('#humidity').textContent=c.relative_humidity_2m+'%';$('#pressure').textContent=Math.round(c.surface_pressure)+' гПа';$('#place').textContent='По текущему местоположению'}
function openPlan(data={}){const d=new Date(Date.now()+3600000);$('#pTitle').value=data.title||'';$('#pDate').value=data.date||d.toISOString().slice(0,10);$('#pTime').value=data.time||d.toTimeString().slice(0,5);$('#pNote').value=data.note||'';$('#planModal').classList.add('open')}
function closePlan(){$('#planModal').classList.remove('open')}
function practices(){return JSON.parse(localStorage.getItem('lunarisV14Practices')||'[]')}
function renderPractices(){const list=practices().sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time));$('#practiceList').innerHTML=list.length?list.map(p=>`<div style="display:grid;grid-template-columns:65px 1fr auto;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid #ffffff0d"><div style="border:1px solid var(--line);border-radius:13px;text-align:center;padding:8px"><b style="display:block;font-size:21px">${new Date(p.date+'T00:00').getDate()}</b><span style="font-size:9px;color:var(--gold2)">${new Intl.DateTimeFormat('ru-RU',{month:'short'}).format(new Date(p.date+'T00:00'))}</span></div><div><b>${p.title}</b><div style="font-size:10px;color:#999;margin-top:5px">${p.time} · ${p.type}</div></div><button data-del="${p.id}" style="border:0;background:#ffffff08;color:#aaa;border-radius:50%;width:32px;height:32px">×</button></div>`).join(''):'<div style="text-align:center;color:#8f8794;padding:35px">${tr().empty}</div>'}
function openInstall(){
 const ua=navigator.userAgent.toLowerCase(),ios=/iphone|ipad|ipod/.test(ua),android=/android/.test(ua),standalone=matchMedia('(display-mode: standalone)').matches||navigator.standalone,steps=$('#iosInstallSteps');
 if(steps)steps.hidden=!ios;
 if(standalone){$('#installText').textContent='LUNARIS уже установлен и запущен как отдельное приложение.';$('#nativeInstall').style.display='none'}
 else if(ios){$('#installText').textContent='Apple не разрешает сайту установить PWA одной кнопкой. Выполните четыре шага ниже — после этого значок LUNARIS появится на экране iPhone.';$('#nativeInstall').style.display='none'}
 else if(state.installPrompt){$('#installText').textContent=android?'Нажмите кнопку ниже — откроется системное окно установки Android.':'Нажмите кнопку ниже — браузер установит LUNARIS как отдельное приложение на компьютере.';$('#nativeInstall').style.display='flex'}
 else{$('#installText').textContent='Откройте сайт в Chrome, Edge или другом браузере с поддержкой PWA и выберите «Установить приложение» в меню браузера.';$('#nativeInstall').style.display='none'}
 $('#installModal').classList.add('open')
}
function renderLang(){
  const langs=[
    ['ru','RU','🇷🇺','Русский','Россия'],
    ['uk','UA','🇺🇦','Українська','Україна'],
    ['kk','KZ','🇰🇿','Қазақша','Қазақстан'],
    ['be','BY','🇧🇾','Беларуская','Беларусь'],
    ['pl','PL','🇵🇱','Polski','Polska'],
    ['en','EN','🇬🇧','English','United Kingdom']
  ];
  $('#langGrid').innerHTML=langs.map(([key,code,flag,name,country])=>`
    <button class="lang-card ${state.lang===key?'active':''}" data-lang="${key}">
      <span class="lang-code">${code}</span>
      <span class="flag" aria-hidden="true">${flag}</span>
      <span class="lang-name"><b>${name}</b><small>${country}</small></span>
    </button>`).join('');
  const current=langs.find(x=>x[0]===state.lang)||langs[0];
  const desktop=$('#langBtn'); if(desktop) desktop.textContent=current[2];
  const mobile=$('#mobileLangBtn'); if(mobile) mobile.textContent=current[2];
}

